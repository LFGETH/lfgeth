# Template for Hardhat + Foundry environment variables.
#
# To use this template, copy this file, rename it .env, and fill in the values.
#
# We provide default values so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# ===== Common (both frameworks) =====
# Alchemy RPC URL - used by both Hardhat and Foundry for network access
ALCHEMY_API_KEY=oKxs-03sij-U_N0iOlrSsZFr29-IqbuF

# ===== Hardhat-specific =====
# Etherscan V2 API key for Hardhat contract verification
ETHERSCAN_V2_API_KEY=

# ===== Foundry-specific =====
# Etherscan API key for Foundry contract verification (see foundry.toml)
ETHERSCAN_API_KEY=DNXJA8RX2Q3VZ4URQIWP7Z68CJXQZSC6AW

# Keystore account name for local Anvil deployments
# Defaults to scaffold-eth-default (anvil's 9th account)
# Change to use a custom keystore: LOCALHOST_KEYSTORE_ACCOUNT=my-account-name
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default
